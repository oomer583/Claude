# generate local secrets with: node scripts/generate-secrets.mjs
AUTH_SECRET=****

# base64-encoded 32-byte key for encrypting internal service credentials at rest
APP_ENCRYPTION_KEY=****

# Public website address used by Caddy.
# Leave as :80 for plain HTTP while testing. Set a real hostname/subdomain such as
# my-ai.example.org to enable automatic HTTPS once DNS points at this server.
SITE_ADDRESS=:80
APP_PORT=3000

# Basic chat-only testing mode.
# Set this to 1 when you want to test chat before Onyx is running.
# Projects, Memory, Research, MCP, Code Interpreter and file editing still require Onyx.
BASIC_CHAT_ONLY=0

# Internal 9Router model gateway (normal production path).
# If 9Router runs directly on the same Linux host rather than in this Compose file,
# host.docker.internal is mapped automatically for the app container.
ROUTER_BASE_URL=http://host.docker.internal:20128/v1
ROUTER_API_KEY=****
# optional override for automatic chat title generation
ROUTER_TITLE_MODEL=

# Optional generic OpenAI-compatible model gateway override.
# Use these for direct testing against a remote llama.cpp/vLLM/Ollama-compatible API.
# When set, these take priority over ROUTER_BASE_URL / ROUTER_API_KEY.
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_API_KEY=
# Force every chat/title request to one model id exposed by the gateway.
# Useful while testing a single self-hosted model. Leave blank for normal 9Router routing.
MODEL_ID=

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Compose-managed PostgreSQL. POSTGRES_URL is overridden inside the app container.
POSTGRES_USER=claude
POSTGRES_PASSWORD=****
POSTGRES_DB=claude
POSTGRES_URL=postgres://claude:****@127.0.0.1:5432/claude

# Compose-managed Redis. REDIS_URL is overridden inside the app container.
REDIS_URL=redis://127.0.0.1:6379

# Private owner-only promo code. Redeeming it grants the owner entitlement without
# sending money through a payment provider. Keep it server-only and hard to guess.
OWNER_PROMO_CODE=****

# Onyx server-side integration.
# If Onyx is published on the same host, use host.docker.internal plus its published
# backend port. If it is on another private host, use that private URL instead.
# These may stay blank only while BASIC_CHAT_ONLY=1.
ONYX_BASE_URL=http://host.docker.internal:8080
# ADMIN Onyx API key used only on the server to provision one BASIC service account
# per product user. Never expose this value to the browser.
ONYX_ADMIN_API_KEY=****
