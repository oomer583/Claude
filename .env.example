# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# base64-encoded 32-byte key for encrypting internal service credentials at rest
# example generation: `openssl rand -base64 32`
APP_ENCRYPTION_KEY=****

# internal 9Router model gateway
ROUTER_BASE_URL=http://9router:20128/v1
ROUTER_API_KEY=****
# optional override for automatic chat title generation
ROUTER_TITLE_MODEL=

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# PostgreSQL connection used by the product database
POSTGRES_URL=****

# Redis connection used for resumable streams and product quotas/rate limits
REDIS_URL=****

# Private owner-only promo code. Redeeming it grants the owner entitlement without
# sending money through a payment provider. Keep it server-only and hard to guess.
OWNER_PROMO_CODE=****

# Onyx server-side integration.
ONYX_BASE_URL=http://onyx:8080
# ADMIN Onyx API key used only on the server to provision one BASIC service account
# per product user. Never expose this value to the browser.
ONYX_ADMIN_API_KEY=****
