# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# internal 9Router model gateway
ROUTER_BASE_URL=http://9router:20128/v1
ROUTER_API_KEY=****
# optional override for automatic chat title generation
ROUTER_TITLE_MODEL=

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# PostgreSQL connection used by the product database
POSTGRES_URL=****

# Redis connection used for resumable streams and product quotas/rate limits
REDIS_URL=****

# Onyx is connected server-side in the next integration layer.
ONYX_BASE_URL=http://onyx:8080
